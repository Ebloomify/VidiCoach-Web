# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# File Upload
UPLOAD_DIR="./uploads/videos"
UPLOAD_TEMP_DIR="./uploads/temp"
MAX_VIDEO_SIZE=2147483648  # 2GB in bytes
VIDEO_CHUNK_SIZE=5242880    # 5MB in bytes

# API Configuration
API_BASE_URL="http://localhost:3000/api"

# External Services
CLOUDINARY_CLOUD_NAME="your-cloudinary-name"
CLOUDINARY_API_KEY="your-cloudinary-key"
CLOUDINARY_API_SECRET="your-cloudinary-secret"

# Email Configuration (Optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# S3/Cloud Storage Configuration
# See docs/S3_STORAGE_QUICKSTART.md for setup instructions
# Leave empty to use local file storage (for development)
S3_BUCKET_NAME="vidicoach-videos"  # Your S3 bucket name
S3_REGION="us-east-1"              # AWS region or S3-compatible service region
S3_ACCESS_KEY_ID="your-s3-access-key"
S3_SECRET_ACCESS_KEY="your-s3-secret-key"
S3_ENDPOINT=""  # Optional: for S3-compatible services like MinIO, Alibaba OSS, Tencent COS
                 # MinIO: http://localhost:9000
                 # Alibaba OSS: https://oss-cn-hangzhou.aliyuncs.com
                 # Tencent COS: https://cos.ap-shanghai.myqcloud.com

# FFmpeg Configuration (Required for video processing)
# See docs/FFMPEG_SETUP_GUIDE.md for installation instructions
FFMPEG_PATH="/usr/bin/ffmpeg"     # Linux/macOS: /usr/bin/ffmpeg or /usr/local/bin/ffmpeg
                                   # Windows: C:\ffmpeg\bin\ffmpeg.exe
                                   # Leave empty if FFmpeg is in system PATH
FFPROBE_PATH="/usr/bin/ffprobe"   # Linux/macOS: /usr/bin/ffprobe or /usr/local/bin/ffprobe
                                   # Windows: C:\ffmpeg\bin\ffprobe.exe
                                   # Leave empty if FFprobe is in system PATH

# Video Processing Configuration
VIDEO_PROCESSING_CONCURRENCY=3     # Max concurrent video processing jobs (recommended: CPU cores)
VIDEO_SESSION_EXPIRY_HOURS=24      # Upload session expiry time in hours
