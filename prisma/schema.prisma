generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model accounts {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  users             users   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model categories {
  id          String    @id
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  courses     courses[]
  series      series[]
}

model comments {
  id        String   @id
  userId    String
  courseId  String
  content   String
  rating    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime
  courses   courses  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model courses {
  id                   String                 @id
  title                String
  description          String?
  categoryId           String
  seriesId             String?
  duration             Int?
  thumbnail            String?
  videoUrl             String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  comments             comments[]
  categories           categories             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  series               series?                @relation(fields: [seriesId], references: [id])
  shares               shares[]
  user_course_progress user_course_progress[]
  user_favorites       user_favorites[]
}

model roles {
  id         Int          @id @default(autoincrement())
  name       String       @unique
  createdAt  DateTime     @default(now())
  updatedAt  DateTime
  user_roles user_roles[]
}

model series {
  id          String     @id
  title       String
  description String?
  categoryId  String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  courses     courses[]
  categories  categories @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model sessions {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model shares {
  id        String   @id
  userId    String
  courseId  String
  platform  String
  createdAt DateTime @default(now())
  courses   courses  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model user_course_progress {
  id            String    @id
  userId        String
  courseId      String
  progress      Float     @default(0)
  completed     Boolean   @default(false)
  lastWatchedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  courses       courses   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  users         users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model user_favorites {
  id        String   @id
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  courses   courses  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model user_roles {
  id     String @id
  userId String
  roleId Int
  roles  roles  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  users  users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model users {
  id                   String                 @id
  name                 String?
  email                String                 @unique
  emailVerified        DateTime?
  image                String?
  password             String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  accounts             accounts[]
  comments             comments[]
  sessions             sessions[]
  shares               shares[]
  user_course_progress user_course_progress[]
  user_favorites       user_favorites[]
  user_roles           user_roles[]
  videos               videos[]
}

model verification_tokens {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// 视频上传处理状态枚举
enum VideoProcessStatus {
  UPLOADING     // 上传中
  UPLOADED      // 上传完成
  PROCESSING    // 处理中
  READY         // 可播放
  FAILED        // 处理失败
}

// 视频分辨率枚举
enum VideoResolution {
  RES_360P
  RES_480P
  RES_720P
  RES_1080P
  RES_2K
  RES_4K
}

// 视频表 - 用于视频上传和处理管理
model videos {
  id              String             @id @default(cuid())
  userId          String
  
  // 基本信息
  title           String
  description     String?
  
  // 文件信息
  originalName    String
  filename        String             // 存储的文件名
  mimeType        String
  fileSize        BigInt             // 文件大小（字节）
  duration        Int?               // 视频时长（秒）
  
  // 处理状态
  status          VideoProcessStatus @default(UPLOADING)
  processError    String?
  processAttempts Int                @default(0)
  
  // 存储路径
  uploadPath      String?            // 原始上传文件路径
  s3Key           String?            // S3 存储键
  s3Bucket        String?            // S3 桶名
  
  // 处理后的视频
  hlsPlaylistUrl  String?            // HLS 播放列表 URL
  dashManifestUrl String?            // DASH 清单 URL
  thumbnailUrl    String?            // 缩略图 URL
  
  // 多码率版本
  versions        video_versions[]
  
  // 元数据
  tags            String[]           @default([])
  category        String?
  viewCount       Int                @default(0)
  
  // 时间戳
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  processStartedAt DateTime?
  processCompletedAt DateTime?
  
  // 关联关系
  user            users              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// 视频版本表 - 存储不同码率和分辨率的版本
model video_versions {
  id         String          @id @default(cuid())
  videoId    String
  
  resolution VideoResolution
  bitrate    Int             // 码率 (kbps)
  fileSize   BigInt          // 文件大小（字节）
  s3Key      String          // S3 存储键
  url        String          // 访问URL
  
  createdAt  DateTime        @default(now())
  
  // 关联关系
  video      videos          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  
  @@index([videoId])
}

// 视频上传会话表 - 用于断点续传
model video_upload_sessions {
  id              String   @id @default(cuid())
  userId          String
  
  // 文件信息
  filename        String
  fileSize        BigInt
  mimeType        String
  totalChunks     Int
  uploadedChunks  Int[]    @default([])
  
  // 元数据
  title           String
  description     String?
  category        String?
  tags            String[] @default([])
  
  // 临时存储路径
  tempPath        String?
  
  // 状态
  completed       Boolean  @default(false)
  videoId         String?  // 合并完成后关联的视频ID
  
  // 时间戳
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime // 会话过期时间
  
  @@index([userId])
  @@index([completed])
}
